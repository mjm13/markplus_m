}

/* 拖拽相关样式 */
.dragging {
  opacity: 0.5 !important;
  transform: rotate(2deg) !important;
  transition: all 0.2s ease;
}

.bookmark-draggable {
  cursor: move;
  transition: all 0.2s ease;
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
}

.bookmark-draggable:hover {
  background-color: #f5f7fa;
  border-radius: 4px;
}

.bookmark-draggable * {
  user-select: none;
  -webkit-user-select: none;
  -moz-user-select: none;
  -ms-user-select: none;
}

/* 书签拖拽悬停效果 */
.bookmark-drag-over {
